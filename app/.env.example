# Copy this to TWO files (both gitignored) instead of a single .env — see README.md's
# "Local setup — app" for the full explanation:
#   cp .env.example .env.local   # local Docker Supabase (`supabase start`)
#   cp .env.example .env.prod    # hosted (balajiinfraandhostel) Supabase project
#
# Run against whichever one you mean, explicitly:
#   flutter run --dart-define-from-file=.env.local
#   flutter run --dart-define-from-file=.env.prod
#
# Never commit either real file. APP_ENV drives the small LOCAL/PROD label shown in debug
# builds (core/environment_label.dart) so it's never ambiguous which backend a running app
# is talking to.
#
# SUPABASE_URL for .env.local depends on what's running the app — 127.0.0.1 means "this
# device itself", which is not your host machine once the app is inside an emulator/on a
# phone:
#   - iOS Simulator:      http://127.0.0.1:54321   (shares the host's network stack)
#   - Android emulator:   http://10.0.2.2:54321     (emulator's fixed alias for host loopback)
#   - Real phone (Wi-Fi): http://<host-LAN-IP>:54321  (e.g. http://192.168.1.23:54321 — find
#     your host's IP with `ipconfig` on Windows; phone and PC must be on the same network,
#     and Windows Firewall must allow inbound TCP on 54321)
#
# SUPABASE_URL for .env.prod is the hosted project's API URL (Dashboard → Settings → API),
# e.g. https://<project-ref>.supabase.co — works from any device, no LAN setup needed.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
APP_ENV=local
