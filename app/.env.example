# Copy to .env (gitignored) and fill in with your local/hosted Supabase project's values.
# Run with: flutter run --dart-define-from-file=.env
# Never commit the real .env file.
#
# SUPABASE_URL depends on what's running the app — 127.0.0.1 means "this device itself",
# which is not your host machine once the app is inside an emulator/on a phone:
#   - iOS Simulator:      http://127.0.0.1:54321   (shares the host's network stack)
#   - Android emulator:   http://10.0.2.2:54321     (emulator's fixed alias for host loopback)
#   - Real phone (Wi-Fi): http://<host-LAN-IP>:54321  (e.g. http://192.168.1.23:54321 — find
#     your host's IP with `ipconfig` on Windows; phone and PC must be on the same network,
#     and Windows Firewall must allow inbound TCP on 54321)

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
