# Copy to supabase/.env (gitignored). Read by `npx supabase` (run from the repo root) for
# env(...) substitution in supabase/config.toml — that substitution has no built-in
# fallback, so `supabase start` errors on a missing var until this file is copied. Not
# read by seed.sql or pgTAP tests — plain SQL files can't see OS environment variables, so
# they stay hardcoded to the fake project id below on purpose (see the comment on
# [auth.third_party.firebase] in config.toml). CI does not use this file; it sets the same
# default directly as a workflow env var (.github/workflows/supabase.yml).

# Fake value: matches seed.sql's app_config.firebase_project_id and every pgTAP test's
# mocked JWT aud/iss (supabase/tests/*.sql). Leave this as-is for normal local dev — the
# app still runs, you just can't complete a real Firebase OTP login against local Supabase.
#
# To test a real Firebase OTP login against local Supabase instead, set this to your real
# Firebase project id (e.g. balajiinfraandhostel), restart `supabase start`, then run the
# app_config sync command documented next to the firebase_project_id row's migration
# comment (and in the Phase 3 PR notes) so app_config matches — seed.sql itself does not
# pick this value up automatically.
SUPABASE_AUTH_FIREBASE_PROJECT_ID=balajiinfra-local-dev
